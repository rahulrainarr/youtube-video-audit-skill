# Application Settings
APP_NAME=Meeting Intelligence Assistant
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./data/mia.db
DATABASE_ECHO=false

# Transcription Settings
TRANSCRIPTION_PROVIDER=faster_whisper
TRANSCRIPTION_MODEL=base
TRANSCRIPTION_LANGUAGE=en
TRANSCRIPTION_DEVICE=auto
TRANSCRIPTION_COMPUTE_TYPE=default
ENABLE_DIARIZATION=true
DIARIZATION_MIN_SPEAKERS=1
DIARIZATION_MAX_SPEAKERS=10

# Local Transcription (faster-whisper)
WHISPER_MODEL_CACHE=./data/models
WHISPER_ENABLE_QUANTIZATION=false

# Cloud Transcription (OpenAI)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_WHISPER_MODEL=whisper-1

# LLM Provider Settings
LLM_PROVIDER=claude
LLM_MODEL=claude-3-5-sonnet-20241022

# Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE=https://api.anthropic.com

# OpenAI Compatible LLM
OPENAI_LLM_API_KEY=
OPENAI_LLM_API_BASE=http://localhost:8000/v1
OPENAI_LLM_MODEL=gpt-3.5-turbo

# Microsoft Teams Integration
TEAMS_ENABLED=false
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_TENANT_ID=
TEAMS_REDIRECT_URI=http://localhost:8501/callback

# File Upload Settings
MAX_UPLOAD_SIZE_MB=5000
ALLOWED_AUDIO_FORMATS=wav,mp3,m4a,aac,flac,ogg
ALLOWED_VIDEO_FORMATS=mp4,mov,mkv,webm,avi,flv
ALLOWED_TRANSCRIPT_FORMATS=vtt,srt,txt,docx
TEMP_DIR=./data/temp

# Data Retention
DATA_RETENTION_DAYS=90
ENABLE_SOFT_DELETE=true
AUTO_CLEANUP_ENABLED=true

# API Settings
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# Security
SECRET_KEY=your-secret-key-change-in-production
ENCRYPT_SENSITIVE_DATA=true
AUDIT_LOGGING_ENABLED=true

# Processing
MAX_CONCURRENT_JOBS=2
CHUNK_SIZE_MINUTES=15
CHUNK_OVERLAP_SECONDS=10
TOKEN_LIMIT_PER_CHUNK=6000

# Feature Flags
FEATURE_TEAMS_GRAPH_INTEGRATION=false
FEATURE_MICROPHONE_RECORDING=false
FEATURE_LOCAL_ONLY_MODE=true

# Logging
LOG_FILE=./logs/mia.log
LOG_FILE_SIZE_MB=100
LOG_BACKUP_COUNT=5

# Performance
ENABLE_CACHING=true
CACHE_TTL_HOURS=24
USE_GPU_IF_AVAILABLE=true

# Reporting
DEFAULT_REPORT_FORMAT=docx
ENABLE_PDF_EXPORT=true
ENABLE_EMAIL_SUMMARY=true
